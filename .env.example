# ─── Environment & Security ──────────────────────────────────────────────────
# ENVIRONMENT: "development", "staging", or "production"
ENVIRONMENT=development

# ADMIN_API_KEY: Strong random secret required in production for all state-changing endpoints
# (e.g. /api/paper/trade, /api/paper/close/*, /api/refresh, /api/retrain, /api/risk/reset-circuit)
ADMIN_API_KEY=change_this_to_a_strong_random_secret_in_production

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite default for local dev.
# In production (RENDER or ENVIRONMENT=production), DATABASE_URL is REQUIRED and MUST
# point to persistent PostgreSQL (e.g. Supabase, Render PostgreSQL, TimescaleDB).
DATABASE_URL=sqlite:///./trading.db
# Production example:
# DATABASE_URL=postgresql://user:password@db.example.com:5432/trading

# Binance (no key needed for public market data)
# BINANCE_API_KEY=
# BINANCE_SECRET=

# Dhan (for live NSE data - optional, not needed for historical)
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=

# Risk Parameters (override defaults)
# MAX_CONSECUTIVE_LOSSES=3
# MIN_RISK_REWARD=2.0
# DAILY_LOSS_LIMIT_PCT=3.0

# Telegram Alerts (free — get from @BotFather on Telegram)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=-1001234567890

# ─── Swing scanner (optional tuning) ─────────────────────────────────────────
# SWING_INDEX_SYMBOL=NIFTY 50
# SWING_REGIME_GATE_ENABLED=true
# SWING_BLOCK_LONG_IN_BEARISH_TREND=true
# SWING_BLOCK_SHORT_IN_BULLISH_TREND=false
# SWING_DEDUPE_ONE_PER_SYMBOL=true

# ─── Swing scanner — Phase 1 accuracy gates ──────────────────────────────────
# Tightened stale-bar cutoff for fresher daily results (was 10, now 5).
# SWING_MAX_BAR_AGE_DAYS=5
# 3-day rolling volume avg / 20-day avg (smooths single-day spike manipulation).
# SWING_VOL_ROLLING_DAYS=3
# Breakout patterns need a trending regime. 0 = disabled. 18 = weak-trend floor.
# Applies to: range breakout, 52W high, BB squeeze, inside-bar breakout.
# SWING_ADX_MIN_FOR_BREAKOUT=18
# Stricter history checks for Golden/Death Cross (EMA_200 garbage on short data).
# SWING_MIN_BARS_FOR_EMA200=220
# SWING_MIN_CLEAN_EMA200_TAIL=20
# Require 2 consecutive closes beyond range_high/52W-high (single-bar = noise).
# SWING_REQUIRE_2BAR_BREAKOUT_CONFIRM=true
# News context only affects grade (default). Set true to also reduce raw strength.
# SWING_NEWS_AFFECTS_STRENGTH=false
# Sector momentum aggregation: "median" (robust) or "mean" (legacy).
# SWING_SECTOR_MOMENTUM_AGG=median
# SwingSetupOutcome tracker (SQLite OPEN → SL / T1 / T2 / EXPIRED via daily yFinance).
# SWING_OUTCOME_EVAL_ENABLED=true
# SWING_OUTCOME_EVAL_INTERVAL_SEC=3600
# SWING_OUTCOME_EVAL_BATCH=120
# SWING_OUTCOME_MAX_HOLD_DAYS=18

# ─── Crypto — Phase 1 accuracy gates ────────────────────────────────────────
# Volume confirmation: entry bar volume must be this multiple of the 20-bar
# rolling average. Lower = more setups but more false signals. 0 = disabled.
# CRYPTO_VOL_MIN_RATIO=1.30
# Funding rate hard gates (per-interval, not annualized):
#   LONG  rejected when funding > CRYPTO_FUNDING_MAX_LONG  (crowded longs)
#   SHORT rejected when funding < CRYPTO_FUNDING_MIN_SHORT (crowded shorts)
# Symbols with missing funding data always pass (gate skipped, not failed).
# CRYPTO_FUNDING_MAX_LONG=0.0005
# CRYPTO_FUNDING_MIN_SHORT=-0.0005
# Master switches — disable a gate without changing its numeric thresholds.
# CRYPTO_VOL_GATE_ENABLED=true
# CRYPTO_FUNDING_GATE_ENABLED=true
# A1 — MTF (4h) confluence gate. LONG needs 4h != BEARISH; SHORT needs 4h != BULLISH.
# Missing 4h data → gate skipped. Strict mode requires exact match (NEUTRAL 4h blocked).
# CRYPTO_MTF_GATE_ENABLED=true
# CRYPTO_MTF_STRICT=false
# CRYPTO_MTF_4H_BARS=200
# Sparse fill — if fewer than CRYPTO_SPARSE_TARGET premium rows, add tier=exploratory from relaxed floors.
# CRYPTO_SPARSE_FILL_ENABLED=true
# CRYPTO_SPARSE_TARGET=5
# CRYPTO_QUALITY_FLOOR=45
# CRYPTO_CONF_FLOOR=35
# CRYPTO_QUALITY_FLOOR_RELAXED=40
# CRYPTO_CONF_FLOOR_RELAXED=28

# ─── Forex Module (100% free — Twelve Data free plan) ──────────────────────
# Sign up (no card): https://twelvedata.com → Dashboard → Copy API key
# Free plan: 800 API calls/day, covers 9 forex pairs easily
TWELVE_DATA_API_KEY=

# ─── Edge Engine (Macro Intelligence Layer) ─────────────────────────────────
# FRED API (100% free — Federal Reserve Economic Data)
# Sign up (no card): https://fred.stlouisfed.org/docs/api/api_key.html
# Free plan: unlimited API calls for macro indicators (GDP, CPI, rates, etc.)
FRED_API_KEY=

# ─── Market context / news (default: 100% free, no keys) ─────────────────────
# RSS + public endpoints only. Paid news/calendar is OFF unless you set:
# CONTEXT_USE_PAID_APIS=true
# MARKETAUX_API_KEY=...
# RAPIDAPI_KEY=...
#
# NSE day-change for context: try nsepython first, then HTTP fallback.
# NSEPYTHON_QUOTES_ENABLED=false
