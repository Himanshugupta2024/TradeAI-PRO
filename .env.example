# Database (SQLite default for local dev, switch to PostgreSQL/TimescaleDB in production)
DATABASE_URL=sqlite:///./trading.db

# Binance (no key needed for public market data)
# BINANCE_API_KEY=
# BINANCE_SECRET=

# Dhan (for live NSE data - optional, not needed for historical)
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=

# Risk Parameters (override defaults)
# MAX_CONSECUTIVE_LOSSES=3
# MIN_RISK_REWARD=2.0
# DAILY_LOSS_LIMIT_PCT=3.0

# Telegram Alerts (free — get from @BotFather on Telegram)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=-1001234567890

# ─── BROKER API — Real NSE Option Chain (OI, PCR, Max Pain) ───────────────────
# NSE's public website blocks Python (Akamai protection).
# Configure ONE broker below to get REAL option chain data.
# All are FREE if you already have a broker account.
#
# ── Option A: Zerodha Kite Connect ──────────────────────────────────────────
# 1. Go to https://developers.kite.trade → Create app → get API Key + Secret
# 2. Daily login: https://kite.trade/connect/login?api_key=YOUR_KEY
#    After redirect, extract access_token from URL or via kite.generate_session()
# Install: pip install kiteconnect
# ZERODHA_API_KEY=your_kite_api_key
# ZERODHA_ACCESS_TOKEN=your_daily_access_token
#
# ── Option B: Angel Broking SmartAPI (RECOMMENDED — fully automated) ────────
# 1. Login to https://smartapi.angelbroking.com → Create App → get API Key
# 2. Enable TOTP on your Angel account, save the TOTP secret key
# No daily manual login needed — TOTP is auto-generated!
# Install: pip install smartapi-python pyotp
# ANGEL_API_KEY=your_angel_api_key
# ANGEL_CLIENT_ID=your_angel_client_id_e.g._A123456
# ANGEL_PASSWORD=your_angel_login_password
# ANGEL_TOTP_SECRET=your_totp_secret_from_authenticator_app
